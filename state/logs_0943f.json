,{"stream_name":"stdout","time":15.67667896,"data":"[eda] 4,407 training studies, 24,371 training series, 15 test series\n"}
,{"stream_name":"stdout","time":15.677429697,"data":"[eda] 58 studies carry all twelve labels; the rest are supervised only by what a text model read out of the report\n"}
,{"stream_name":"stdout","time":16.22955107,"data":"Coverage of the six slots the models expect, over training studies:\n"}
,{"stream_name":"stdout","time":16.229582261,"data":"               slot  studies with it  share\n"}
,{"stream_name":"stdout","time":16.229602764,"data":"   Sagittal fat-sat             4150  0.942\n"}
,{"stream_name":"stdout","time":16.229607401,"data":"Sagittal no fat-sat             4266  0.968\n"}
,{"stream_name":"stdout","time":16.229611225,"data":"    Coronal fat-sat             4248  0.964\n"}
